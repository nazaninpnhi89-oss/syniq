# ===== SYNIQ — متغیرهای محیطی =====
# این فایل را به .env.local کپی کنید و مقادیر واقعی را بگذارید.
# cp .env.example .env.local

# آدرس عمومی سایت (برای بازگشت استرایپ و متادیتا)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Supabase (دیتابیس + احراز هویت) -----
# از داشبورد Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# کلید سرویس (فقط سمت سرور — هرگز علنی نشود) برای Webhook استرایپ
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (پرداخت) -----
# از داشبورد Stripe → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# امضای Webhook (از تنظیمات Webhook یا خروجی `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# ----- منطقه‌ی زمانی کسب‌وکار (ساعات کاری/اسلات‌های رزرو) -----
# مثال: Europe/Berlin , America/Toronto , Asia/Tehran
BUSINESS_TIMEZONE=Europe/Berlin

# ----- Resend (ایمیل تأیید رزرو) -----
RESEND_API_KEY=
# ایمیل فرستنده (باید دامنه‌اش در Resend تأیید شده باشد)
EMAIL_FROM="SYNIQ <booking@syniq.ai>"
# ایمیل نازنین برای دریافت اعلان رزرو جدید
ADMIN_EMAIL=

# ----- OpenRouter (chat brain — Gemini 2.0 Flash) -----
# Get key from: openrouter.ai → Keys
OPENROUTER_API_KEY=

# ----- Voyage AI (embeddings برای RAG) -----
# از dash.voyageai.com → API Keys  (پلن رایگان: ۵۰ میلیون توکن/ماه)
VOYAGE_API_KEY=

# ----- Telegram Bot -----
# از @BotFather در تلگرام
TELEGRAM_BOT_TOKEN=
# یک رشته دلخواه برای تأیید درخواست‌های webhook (اختیاری)
TELEGRAM_WEBHOOK_SECRET=

# ----- Future embedding providers (اختیاری — فعلاً «coming soon») -----
# OpenAI embeddings
OPENAI_API_KEY=
# Cohere embeddings
COHERE_API_KEY=
# Google embeddings
GOOGLE_API_KEY=

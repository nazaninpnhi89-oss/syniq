# ===== SYNIQ — متغیرهای محیطی =====
# این فایل را به .env.local کپی کنید و مقادیر واقعی را بگذارید.
# cp .env.example .env.local

# آدرس عمومی سایت (برای بازگشت استرایپ و متادیتا)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Supabase (دیتابیس + احراز هویت) -----
# از داشبورد Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# کلید سرویس (فقط سمت سرور — هرگز علنی نشود) برای Webhook استرایپ
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (پرداخت) -----
# از داشبورد Stripe → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# امضای Webhook (از تنظیمات Webhook یا خروجی `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# ----- منطقه‌ی زمانی کسب‌وکار (ساعات کاری/اسلات‌های رزرو) -----
# مثال: Europe/Berlin , America/Toronto , Asia/Tehran
BUSINESS_TIMEZONE=Europe/Berlin

# ----- Resend (ایمیل تأیید رزرو) -----
RESEND_API_KEY=
# ایمیل فرستنده (باید دامنه‌اش در Resend تأیید شده باشد)
EMAIL_FROM="SYNIQ <booking@syniq.ai>"
# ایمیل نازنین برای دریافت اعلان رزرو جدید
ADMIN_EMAIL=
